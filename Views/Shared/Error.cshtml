@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<div class="empty-box">
    <h1>Произошла ошибка</h1>
    <p>Не удалось обработать запрос. Попробуйте ещё раз немного позже.</p>
    @if (Model.ShowRequestId)
    {
        <p class="page-sub">Код запроса: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn-shop">На главную</a>
</div>
