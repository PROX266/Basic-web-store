@model WebApplication1.Models.OrderItem

<div class="mb-3">
    <label asp-for="OrderId" class="form-label">Заказ</label>
    <select asp-for="OrderId" asp-items="ViewBag.Orders" class="form-select"></select>
    <span asp-validation-for="OrderId" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="ProductId" class="form-label">Товар</label>
    <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select"></select>
    <span asp-validation-for="ProductId" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Quantity" class="form-label">Количество</label>
    <input asp-for="Quantity" type="number" min="1" class="form-control" />
    <span asp-validation-for="Quantity" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Price" class="form-label">Цена за единицу</label>
    <input asp-for="Price" type="text" inputmode="decimal" class="form-control" placeholder="Например: 1999,99" />
    <span asp-validation-for="Price" class="text-danger"></span>
</div>
