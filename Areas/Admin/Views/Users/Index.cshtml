@model IEnumerable<WebApplication1.Models.User>

@{
    ViewData["Title"] = "Пользователи";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Пользователи</h2>
    <a asp-action="Create" class="btn btn-primary">+ Добавить</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Логин</th>
                    <th>Имя</th>
                    <th>Роль</th>
                    <th>Активен</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.UserLogin</td>
                    <td>@item.UserName</td>
                    <td>@item.Role.RoleName</td>
                    <td>@(item.IsActive ? "Да" : "Нет")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                    </td>
                </tr>
                }
                @if (!Model.Any())
                {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Записей пока нет</td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>
