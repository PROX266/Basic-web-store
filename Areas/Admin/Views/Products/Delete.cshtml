@model WebApplication1.Models.Product

@{
    ViewData["Title"] = "Удаление — Товары";
}

<h2 class="mb-3">Удаление записи: Товар</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="alert alert-warning">Вы действительно хотите удалить эту запись?</div>
        <dl class="row">
        <dt class="col-sm-4">ID</dt>
        <dd class="col-sm-8">@Model.Id</dd>
        <dt class="col-sm-4">Название</dt>
        <dd class="col-sm-8">@Model.ProductName</dd>
        <dt class="col-sm-4">Цена</dt>
        <dd class="col-sm-8">@Model.Price.ToString("N2") ₽</dd>
        <dt class="col-sm-4">Категория</dt>
        <dd class="col-sm-8">@Model.Category.NameCategories</dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Да, удалить</button>
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>
